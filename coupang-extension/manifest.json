{
    "manifest_version": 3,
    "name": "Coupang Price Tracker",
    "version": "2.3.0",
    "description": "쿠팡 제품 가격을 자동으로 수집하여 Supabase에 저장합니다",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "*://*.coupang.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://rmbowbqxdryndsekobmh.supabase.co/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.coupang.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "http://localhost:3000/*",
                "http://127.0.0.1:3000/*"
            ],
            "js": [
                "ygif-content.js"
            ],
            "run_at": "document_end"
        }
    ]
}
